# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, so it
# must never contain a real key.
#
# ---------------------------------------------------------------------------
# Tagging provider (word-level LID + semantic class)
# ---------------------------------------------------------------------------
# ONE of these is enough. `make_tagger()` picks the first key it finds, in the
# order below, and `--provider` overrides that. With none of them set the
# pipeline degrades to rules-only, which cannot assign semantic class -- every
# token becomes OTHER, every speaker's graph becomes identical, and every LLR
# is zero. So one of these is required before any CSBG number exists.

# Gemini -- free, https://aistudio.google.com/apikey. Preferred: this task is
# word-level LID on romanised Tamil, and Gemini Flash carries more Tamil than
# the Llama checkpoints Groq serves.
GEMINI_API_KEY=

# Groq -- free, https://console.groq.com/keys. Fast; the fallback for when
# Gemini's daily quota runs out part-way through a corpus.
GROQ_API_KEY=

# Paid. Only these two reach the Batch API and prompt caching, which halve the
# cost of a large corpus; neither matters at this corpus size.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime settings (pydantic-settings, KAVACH_ prefix -- see config.py)
# ---------------------------------------------------------------------------
# Force degraded mode: no model downloads, no network.
# KAVACH_OFFLINE=1

# Whether /api/challenge may return the expected answer. Leave false. True
# turns the demo endpoint into an oracle that hands an attacker the answer it
# is about to check them against.
# KAVACH_DEMO_REVEAL_ANSWERS=false
